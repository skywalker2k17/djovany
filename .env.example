# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real credentials.

# Where project briefs are delivered
MAIL_TO=djovanylevasseur93@gmail.com

# SMTP — Gmail
# Requires 2-step verification, then an App Password:
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=djovanylevasseur93@gmail.com
SMTP_PASS=your-16-character-app-password

# Port 465 uses SSL. Use 587 for STARTTLS if 465 is blocked.
